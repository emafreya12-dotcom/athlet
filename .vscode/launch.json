{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Athlet Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port",
                "8501"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Open Athlet in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8501",
            "webRoot": "${workspaceFolder}"
        }
    ]
}